{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/production-media",
      "destination": "/grow",
      "permanent": false
    },
    {
      "source": "/production-media.html",
      "destination": "/grow",
      "permanent": false
    },
    {
      "source": "/growth-guide",
      "destination": "/grow",
      "permanent": false
    },
    {
      "source": "/growth-guide.html",
      "destination": "/grow",
      "permanent": false
    },
    {
      "source": "/production-inquiry",
      "destination": "/next-step",
      "permanent": false
    },
    {
      "source": "/production-inquiry.html",
      "destination": "/next-step",
      "permanent": false
    },
    {
      "source": "/book",
      "destination": "/strategy-call",
      "permanent": false
    },
    {
      "source": "/book.html",
      "destination": "/strategy-call",
      "permanent": false
    },
    {
      "source": "/booking",
      "destination": "/strategy-call",
      "permanent": false
    },
    {
      "source": "/book-a-call",
      "destination": "/strategy-call",
      "permanent": false
    },
    {
      "source": "/book-call",
      "destination": "/strategy-call",
      "permanent": false
    },
    {
      "source": "/schedule",
      "destination": "/strategy-call",
      "permanent": false
    },
    {
      "source": "/call",
      "destination": "/strategy-call",
      "permanent": false
    },
    {
      "source": "/brandbuilder",
      "destination": "/brand-builder",
      "permanent": false
    },
    {
      "source": "/brandbuilder.html",
      "destination": "/brand-builder",
      "permanent": false
    },
    {
      "source": "/brand-builder.html",
      "destination": "/brand-builder",
      "permanent": false
    },
    {
      "source": "/brandbuilder-pro",
      "destination": "/brand-builder-pro",
      "permanent": false
    },
    {
      "source": "/brand-builder-pro.html",
      "destination": "/brand-builder-pro",
      "permanent": false
    }
  ],
  "crons": [
    { "path": "/api/meta-sync", "schedule": "0 13 * * *" }
  ],
  "headers": [
    {
      "source": "/d/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/owner(\\.html)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/d/:path*",
      "destination": "https://ntc-agent-production.up.railway.app/d/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
