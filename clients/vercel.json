{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "eddie.newterraincreative.com"
        }
      ],
      "destination": "/eddie"
    },
    {
      "source": "/:path((?!eddie/).+)",
      "has": [
        {
          "type": "host",
          "value": "eddie.newterraincreative.com"
        }
      ],
      "destination": "/eddie/:path"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
